{
  "expo": {
    "name": "PartVision",
    "slug": "part-vision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partvision.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PartVision needs camera access to stream frames for real-time car part detection."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.partvision.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "PartVision needs camera access to stream frames for real-time car part detection.",
          "enableCodec": "hevc"
        }
      ]
    ],
    "experiments": {},
    "extra": {
      "backendUrl": "ws://10.0.2.2:5555/ws/segment"
    }
  }
}
